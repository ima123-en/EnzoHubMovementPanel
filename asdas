    local function noteLagback()
        local now = tick()
        if now - lastLag < 0.15 then return end
        lastLag = now
        if now - lagWindow > 3 then
            lagCount = 0
            lagWindow = now
        end
        lagCount = lagCount + 1
        if lagCount >= 15 then
