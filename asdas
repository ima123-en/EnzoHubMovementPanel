local function makeCheckbox(parent, initial, onToggle)
	local box = Instance.new("TextButton", parent)
	box.Size = UDim2.new(0, 12, 0, 12)
	box.Position = UDim2.new(0, 6, 0.5, -6)
	box.BackgroundColor3 = THEME_BG
	box.BorderSizePixel = 0
	box.Text = ""
	box.AutoButtonColor = false
	corner(box); stroke(box)
	local check = Instance.new("Frame", box)
	check.Size = UDim2.new(0, 6, 0, 6)
	check.Position = UDim2.new(0.5, -3, 0.5, -3)
	check.BackgroundColor3 = THEME_ACCENT
	check.BorderSizePixel = 0
	check.Visible = initial and true or false
	corner(check, 1)
	local state = initial and true or false
	local function set(v, fire)
		state = v and true or false
		check.Visible = state
		if fire and onToggle then onToggle(state) end
	end
	AddConn(box.MouseButton1Click:Connect(function() set(not state, true) end))
	return set, function() return state end
end

