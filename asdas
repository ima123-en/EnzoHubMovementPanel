local draggingPanel = false
local dragStart, startPos
AddConn(Header.InputBegan:Connect(function(i)
	if isInteractingWithSlider then return end
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		draggingPanel = true
		dragStart = i.Position
		startPos = Main.Position
	end
end))
AddConn(UserInputService.InputChanged:Connect(function(input)
	if draggingPanel and not isInteractingWithSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end))
AddConn(UserInputService.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		if draggingPanel then
			draggingPanel = false
			local pos = Main.Position
			_G.InvisGuiPosXScale  = pos.X.Scale
			_G.InvisGuiPosXOffset = pos.X.Offset
			_G.InvisGuiPosYScale  = pos.Y.Scale
			_G.InvisGuiPosYOffset = pos.Y.Offset
			SaveSettings()
		end
	end
end))

AddConn(UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local keyName = input.KeyCode.Name

	if _G.WaitingForInvisKey then
		_G.WaitingForInvisKey = false
		if keyName and keyName ~= "Unknown" then
			_G.INVISIBLE_STEAL_KEY = keyName
			SaveSettings()
		end
		if _G.InvisKeyButton then _G.InvisKeyButton.Text = _G.INVISIBLE_STEAL_KEY:upper() end
		return
	end
	if _G.WaitingForFloatKey then
		_G.WaitingForFloatKey = false
		if keyName and keyName ~= "Unknown" then
			_G.FLOAT_KEY = keyName
			SaveSettings()
		end
		if _G.FloatKeyButton then _G.FloatKeyButton.Text = _G.FLOAT_KEY:upper() end
		return
	end

	local invisKeyCode = Enum.KeyCode[_G.INVISIBLE_STEAL_KEY]
	if invisKeyCode and input.KeyCode == invisKeyCode then
		pcall(_G.toggleInvisibleSteal)
		if enabledRowUpdate then enabledRowUpdate(_G.invisibleStealEnabled) end
		return
	end
	local floatKeyCode = Enum.KeyCode[_G.FLOAT_KEY]
	if floatKeyCode and input.KeyCode == floatKeyCode then
		FloatEnabled = not FloatEnabled
		if _G.UpdateFloatButton then _G.UpdateFloatButton(FloatEnabled) end
		if FloatEnabled then StartFloat() else StopFloat() end
	end
end))

