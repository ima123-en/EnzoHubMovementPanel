	if camera and newChar then
		local h = newChar:FindFirstChildOfClass("Humanoid")
		if h then camera.CameraSubject = h; camera.CameraType = Enum.CameraType.Custom end
	end
	if wsOn then task.wait(0.4); wsStart() end
end
