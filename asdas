local function turnOff()
	clearAllGhosts()
	_G.invisibleStealEnabled = false
	UnwalkSuspended = false
	if not animPlaying then return end
	animPlaying = false
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	for _, t in pairs(tracks) do pcall(function() if t and t.IsPlaying then t:Stop() end end) end
	tracks = {}
	if connection then pcall(function() connection:Disconnect() end); connection = nil end
	revertClone()
	showCharacterVisual()
	if humanoid and humanoid.Health > 0 then
		task.wait(0.1)
		pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
	end
end

local function turnOn()
	if animPlaying then return end
	local character = LocalPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	animPlaying = true
	_G.invisibleStealEnabled = true
	UnwalkSuspended = true
	tracks = {}
	removeFolders()
	local success = doClone()
	if not success then
		animPlaying = false
		_G.invisibleStealEnabled = false
		UnwalkSuspended = false
		return
	end
	hideCharacterVisual()
	task.wait(0.05)
	animationTrickery()
	task.defer(function()
		if _G.resetBrainrotBeam then pcall(_G.resetBrainrotBeam) end
		if _G.resetPlotBeam then pcall(_G.resetPlotBeam) end
		task.wait(0.1)
		if _G.updateBrainrotBeam then pcall(_G.updateBrainrotBeam) end
		if _G.createPlotBeam then pcall(_G.createPlotBeam) end
	end)
	local lastSetPosition = nil
	local skipFrames = 5
	connection = RunService.PreSimulation:Connect(function()
		local char = LocalPlayer.Character
		if not char then return end
		local hum = char:FindFirstChild("Humanoid")
		if not hum or hum.Health <= 0 then return end
		if not oldRoot or not oldRoot.Parent then return end
		local root = char.PrimaryPart or char:FindFirstChild("HumanoidRootPart")
		if not root then return end
		if skipFrames > 0 then skipFrames = skipFrames - 1; lastSetPosition = nil; return end
		if lastSetPosition then
			local currentPos = oldRoot.Position
			local jumpDist = (currentPos - lastSetPosition).Magnitude
			if jumpDist > 8 and not _G.RecoveryInProgress then
				lastSetPosition = nil
				createServerGhost(currentPos)
				if _G.AutoRecoverLagback and _G.toggleInvisibleSteal then
					_G.RecoveryInProgress = true
					task.spawn(function()
						pcall(_G.toggleInvisibleSteal)
						task.wait(0.5)
						pcall(_G.toggleInvisibleSteal)
						_G.RecoveryInProgress = false
					end)
				end
			end
		end
		if clone then clone.CanCollide = true end
		for _, c in pairs(oldRoot:GetChildren()) do
			if c:IsA("Attachment") or c:IsA("Beam") or c:IsA("ParticleEmitter") then pcall(function() c:Destroy() end) end
		end
		local rotAngle = _G.InvisStealAngle or 233
		local sa = (_G.SinkSliderValue or 5) * 0.5
		local cf = root.CFrame - Vector3.new(0, sa, 0)
		oldRoot.CFrame = cf * CFrame.Angles(math.rad(rotAngle), 0, 0)
		oldRoot.AssemblyLinearVelocity = root.AssemblyLinearVelocity
		oldRoot.CanCollide = false
		lastSetPosition = oldRoot.Position
	end)
	AddConn(connection)
end

