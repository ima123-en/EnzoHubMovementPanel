local function doClone()
	local character = LocalPlayer.Character
	if not character then return false end
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end
	hip = humanoid.HipHeight
	oldRoot = character:FindFirstChild("HumanoidRootPart")
	if not oldRoot or not oldRoot.Parent then return false end
	for _, c in pairs(oldRoot:GetChildren()) do
		if c:IsA("Attachment") or c:IsA("Beam") or c:IsA("ParticleEmitter") then
			pcall(function() c:Destroy() end)
		end
	end
	local success, err = pcall(function()
		local tmp = Instance.new("Model")
		tmp.Parent = game
		character.Parent = tmp
		clone = oldRoot:Clone()
		clone.Name = "HumanoidRootPart"
		clone.Transparency = oldRoot.Transparency
		clone.CanCollide = true
		for _, c in pairs(clone:GetChildren()) do
			if c:IsA("Attachment") or c:IsA("Beam") or c:IsA("ParticleEmitter") then c:Destroy() end
		end
		clone.Parent = character
		oldRoot.Parent = Workspace.CurrentCamera
		clone.CFrame = oldRoot.CFrame
		character.PrimaryPart = clone
		character.Parent = Workspace
		for _, v in pairs(character:GetDescendants()) do
			if v:IsA("Weld") or v:IsA("Motor6D") then
				if v.Part0 == oldRoot then v.Part0 = clone end
				if v.Part1 == oldRoot then v.Part1 = clone end
			end
		end
		tmp:Destroy()
	end)
	if not success then warn("Clone failed:", err) return false end
	return true
end

local function revertClone()
	local character = LocalPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid then return end
	if not oldRoot or not oldRoot:IsDescendantOf(Workspace) then
		if oldRoot then pcall(function() oldRoot:Destroy() end) end
		oldRoot = nil; clone = nil
		return
	end
	local success = pcall(function()
		local tmp = Instance.new("Model")
		tmp.Parent = game
		character.Parent = tmp
		oldRoot.Parent = character
		character.PrimaryPart = oldRoot
		character.Parent = Workspace
		oldRoot.CanCollide = true
		for _, v in pairs(character:GetDescendants()) do
			if v:IsA("Weld") or v:IsA("Motor6D") then
				if v.Part0 == clone then v.Part0 = oldRoot end
				if v.Part1 == clone then v.Part1 = oldRoot end
			end
		end
		if clone then
			local p = clone.CFrame
			clone:Destroy(); clone = nil
			oldRoot.CFrame = p
		end
		tmp:Destroy()
	end)
	if not success then
		if oldRoot then pcall(function() oldRoot:Destroy() end) end
		if clone then pcall(function() clone:Destroy() end) end
	end
	oldRoot = nil; clone = nil
	if character and humanoid then humanoid.HipHeight = hip or 0 end
	clearAllGhosts()
end

local function animationTrickery()
	local character = LocalPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	local anim = Instance.new("Animation")
	anim.AnimationId = "http://www.roblox.com/asset/?id=18537363391"
	local animator = humanoid:FindFirstChild("Animator") or Instance.new("Animator", humanoid)
	local animTrack = animator:LoadAnimation(anim)
	animTrack.Priority = Enum.AnimationPriority.Action4
	animTrack:Play(0, 1, 0)
	anim:Destroy()
	table.insert(tracks, animTrack)
	AddConn(animTrack.Stopped:Connect(function()
		if animPlaying then task.wait(0.05); animationTrickery() end
	end))
	task.spawn(function()
		animTrack.TimePosition = 0.7
		task.wait(0.3)
		if animTrack and animTrack.IsPlaying then animTrack:AdjustSpeed(math.huge) end
	end)
end

