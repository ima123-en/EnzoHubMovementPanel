_G.SMKTWalkSpeed = _G.SMKTWalkSpeed or 16
_G.SMKTWalkSpeedOn = _G.SMKTWalkSpeedOn or false
local wsOn = _G.SMKTWalkSpeedOn or false
local wsConn = nil

local function wsStop()
    if wsConn then pcall(function() wsConn:Disconnect() end); wsConn = nil end
end

local function wsStart()
    wsStop()
    wsConn = RunService.Heartbeat:Connect(function(dt)
        local c = LocalPlayer.Character
        if not c then return end
        local hum = c:FindFirstChildOfClass("Humanoid")
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then return end
        local want = math.clamp(tonumber(_G.SMKTWalkSpeed) or 16, 16, 29)
        local md = hum.MoveDirection
        if md.Magnitude > 0 and want > hum.WalkSpeed then
            hrp.CFrame = hrp.CFrame + (md * (want - hum.WalkSpeed) * dt)
        end
    end)
end

_G.SMKTSetWalkSpeed = function(on)
    wsOn = on and true or false
    _G.SMKTWalkSpeedOn = wsOn
    if wsOn then wsStart() else wsStop() end
end

local SAVE_KEY = "InvisSteal_Settings_" .. LocalPlayer.UserId
local function SaveSettings()
    pcall(function()
        if writefile then
            writefile(SAVE_KEY .. ".json", HttpService:JSONEncode({
                SMKTInvisAngle = _G.SMKTInvisAngle,
                SMKTInvisDepth = _G.SMKTInvisDepth,
                SMKTInvisAuto = _G.SMKTInvisAuto,
                INVISIBLE_STEAL_KEY = _G.INVISIBLE_STEAL_KEY,
                InvisGuiScale = _G.InvisGuiScale,
                UnwalkSavedState = _G.UnwalkSavedState,
                SMKTWalkSpeed = _G.SMKTWalkSpeed,
                SMKTWalkSpeedOn = _G.SMKTWalkSpeedOn,
                GuiPos = { XScale = _G.InvisGuiPosXScale or 0, XOffset = _G.InvisGuiPosXOffset or 20, YScale = _G.InvisGuiPosYScale or 0.25, YOffset = _G.InvisGuiPosYOffset or 0 }
            }))
        end
    end)
end

local function LoadSettings()
    pcall(function()
        if readfile and isfile and isfile(SAVE_KEY .. ".json") then
            local data = HttpService:JSONDecode(readfile(SAVE_KEY .. ".json"))
            if data.SMKTInvisAngle then _G.SMKTInvisAngle = data.SMKTInvisAngle end
            if data.SMKTInvisDepth then _G.SMKTInvisDepth = data.SMKTInvisDepth end
            if data.SMKTInvisAuto ~= nil then _G.SMKTInvisAuto = data.SMKTInvisAuto end
            if data.INVISIBLE_STEAL_KEY then _G.INVISIBLE_STEAL_KEY = data.INVISIBLE_STEAL_KEY end
            if data.InvisGuiScale ~= nil then _G.InvisGuiScale = data.InvisGuiScale end
            if data.UnwalkSavedState ~= nil then _G.UnwalkSavedState = data.UnwalkSavedState end
            if data.SMKTWalkSpeed then _G.SMKTWalkSpeed = data.SMKTWalkSpeed end
            if data.SMKTWalkSpeedOn ~= nil then _G.SMKTWalkSpeedOn = data.SMKTWalkSpeedOn end
            if data.GuiPos then
                _G.InvisGuiPosXScale = data.GuiPos.XScale or 0
                _G.InvisGuiPosXOffset = data.GuiPos.XOffset or 20
                _G.InvisGuiPosYScale = data.GuiPos.YScale or 0.25
                _G.InvisGuiPosYOffset = data.GuiPos.YOffset or 0
            end
        end
    end)
end
LoadSettings()

