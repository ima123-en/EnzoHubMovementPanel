do
    _G.SMKTNoPlayerCollide = true
    local clones = setmetatable({}, { __mode = "k" })

    local function isCloneModel(m)
        if not m:IsA("Model") then return false end
        if not m:FindFirstChild("HumanoidRootPart") then return false end
        if not m:FindFirstChildOfClass("Humanoid") then return false end
        if Players:GetPlayerFromCharacter(m) then return false end
        if m.Name:lower():find("clone", 1, true) then return true end
        local head = m:FindFirstChild("Head")
        return head ~= nil and head:IsA("BasePart")
    end

    local function consider(o)
        if isCloneModel(o) then clones[o] = true end
    end

    Workspace.DescendantAdded:Connect(function(o)
        if not o:IsA("Model") then return end
        task.delay(0.5, function()
            if o.Parent then pcall(consider, o) end
        end)
    end)

    task.spawn(function()
        local n = 0
        for _, o in ipairs(Workspace:GetDescendants()) do
            if o:IsA("Model") then pcall(consider, o) end
            n += 1
            if n % 3000 == 0 then task.wait() end
        end
    end)

    RunService.Stepped:Connect(function()
        if _G.SMKTNoPlayerCollide == false then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                for _, p in ipairs(plr.Character:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
                end
            end
        end
        for m in pairs(clones) do
            if m.Parent then
                for _, p in ipairs(m:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
                end
            else
                clones[m] = nil
            end
        end
    end)

    _G.SMKTNoCollideSweep = function() end
end

_G.SMKTWalkSpeed = _G.SMKTWalkSpeed or 16
_G.SMKTWalkSpeedOn = _G.SMKTWalkSpeedOn or false
local wsOn = _G.SMKTWalkSpeedOn or false
local wsConn = nil

local function wsStop()
    if wsConn then pcall(function() wsConn:Disconnect() end); wsConn = nil end
end

local function wsStart()
    wsStop()
    wsConn = RunService.Heartbeat:Connect(function(dt)
        local c = LocalPlayer.Character
        if not c then return end
        local hum = c:FindFirstChildOfClass("Humanoid")
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then return end
        local want = math.clamp(tonumber(_G.SMKTWalkSpeed) or 16, 16, 29)
        local md = hum.MoveDirection
        if md.Magnitude > 0 and want > hum.WalkSpeed then
            hrp.CFrame = hrp.CFrame + (md * (want - hum.WalkSpeed) * dt)
        end
    end)
end

_G.SMKTSetWalkSpeed = function(on)
    wsOn = on and true or false
    _G.SMKTWalkSpeedOn = wsOn
    if wsOn then wsStart() else wsStop() end
end

