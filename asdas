local function createToggleRow(text, initial, onToggle)
    local row = makeRow(24)
    local set = makeCheckbox(row, initial, onToggle)
    makeLabel(row, text, 24, UDim2.new(1, -30, 1, 0))
    return set
end

local function createKeyToggleRow(text, keyName, initial, onToggle, onKeyClick)
    local row = makeRow(24)
    local set = makeCheckbox(row, initial, onToggle)
    makeLabel(row, text, 24, UDim2.new(1, -76, 1, 0))
    local keyBtn = Instance.new("TextButton", row)
    keyBtn.AnchorPoint = Vector2.new(1, 0.5)
    keyBtn.Position = UDim2.new(1, -6, 0.5, 0)
    keyBtn.Size = UDim2.new(0, 42, 0, 16)
    keyBtn.BackgroundColor3 = THEME_BG
    keyBtn.BorderSizePixel = 0
    keyBtn.Font = THEME_FONT
    keyBtn.TextSize = 9
    keyBtn.Text = tostring(keyName):upper()
    keyBtn.TextColor3 = THEME_TEXT_MUTED
    keyBtn.AutoButtonColor = false
    corner(keyBtn); stroke(keyBtn)
    AddConn(keyBtn.MouseButton1Click:Connect(function() if onKeyClick then onKeyClick(keyBtn) end end))
    return set, keyBtn
end

local function createStepperRow(labelText, minVal, maxVal, step, getVal, setVal, suffix)
    local row = makeRow(24)
    makeLabel(row, labelText, 6, UDim2.new(0.5, -6, 1, 0))

    local valLbl = Instance.new("TextLabel", row)
    valLbl.AnchorPoint = Vector2.new(1, 0.5)
    valLbl.Position = UDim2.new(1, -38, 0.5, 0)
    valLbl.Size = UDim2.new(0, 50, 1, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.Font = THEME_FONT
    valLbl.TextSize = 9
    valLbl.TextColor3 = THEME_TEXT_PRIMARY
    valLbl.TextXAlignment = Enum.TextXAlignment.Right

    local minusBtn = Instance.new("TextButton", row)
    minusBtn.AnchorPoint = Vector2.new(1, 0.5)
    minusBtn.Position = UDim2.new(1, -20, 0.5, 0)
    minusBtn.Size = UDim2.new(0, 16, 0, 16)
    minusBtn.BackgroundColor3 = THEME_BG
    minusBtn.BorderSizePixel = 0
    minusBtn.Text = "-"
    minusBtn.Font = THEME_FONT
    minusBtn.TextSize = 10
    minusBtn.TextColor3 = THEME_TEXT_PRIMARY
    corner(minusBtn); stroke(minusBtn)

    local plusBtn = Instance.new("TextButton", row)
    plusBtn.AnchorPoint = Vector2.new(1, 0.5)
    plusBtn.Position = UDim2.new(1, -2, 0.5, 0)
    plusBtn.Size = UDim2.new(0, 16, 0, 16)
    plusBtn.BackgroundColor3 = THEME_BG
    plusBtn.BorderSizePixel = 0
    plusBtn.Text = "+"
    plusBtn.Font = THEME_FONT
    plusBtn.TextSize = 10
    plusBtn.TextColor3 = THEME_TEXT_PRIMARY
    corner(plusBtn); stroke(plusBtn)

    local function update()
        local v = getVal()
        if step < 1 then
            valLbl.Text = string.format("%.1f%s", v, suffix or "")
        else
            valLbl.Text = tostring(math.floor(v + 0.5)) .. (suffix or "")
        end
    end

    AddConn(plusBtn.MouseButton1Click:Connect(function()
        local v = getVal() + step
        if v > maxVal then v = minVal end
        setVal(v)
        update()
        SaveSettings()
    end))

    AddConn(minusBtn.MouseButton1Click:Connect(function()
        local v = getVal() - step
        if v < minVal then v = maxVal end
        setVal(v)
        update()
        SaveSettings()
    end))

    update()
    return update
end

makeSection("Steal")

local invisKeyBtnRef
local invisSet
invisSet, invisKeyBtnRef = createKeyToggleRow("Invis Steal", _G.INVISIBLE_STEAL_KEY, SMKTInvisActive,
    function()
        if _G.toggleInvisibleSteal then pcall(_G.toggleInvisibleSteal) end
    end,
    function(keyBtn)
        _G.WaitingForInvisKey = true
        keyBtn.Text = "..."
    end
)
_G.InvisKeyButton = invisKeyBtnRef
enabledRowUpdate = function(state) invisSet(state, false) end
_G.UpdateInvisButton = enabledRowUpdate

createToggleRow("Unwalk", _G.UnwalkSavedState, function(state)
    _G.UnwalkSavedState = state
    SaveSettings()
end)

AddConn(RunService.Heartbeat:Connect(function()
    local isStealing = SMKTInvisActive or LocalPlayer:GetAttribute("Stealing") == true
    if _G.UnwalkSavedState and not isStealing then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                pcall(function() t:Stop() end)
            end
        end
    end
end))

createToggleRow("Auto Invis on Steal", _G.SMKTInvisAuto, function(state)
    _G.SMKTInvisAuto = state
    SaveSettings()
end)

createStepperRow("Rotation", 0, 360, 5,
    function() return _G.SMKTInvisAngle end,
    function(v) _G.SMKTInvisAngle = v end
)
createStepperRow("Depth", 0, 10, 0.2,
    function() return _G.SMKTInvisDepth end,
    function(v) _G.SMKTInvisDepth = v end
)

makeSection("WalkSpeed")

createToggleRow("WalkSpeed", _G.SMKTWalkSpeedOn, function(state)
    _G.SMKTSetWalkSpeed(state)
    SaveSettings()
end)

createStepperRow("Speed", 16, 29, 1,
    function() return _G.SMKTWalkSpeed end,
    function(v)
        _G.SMKTWalkSpeed = math.clamp(math.floor(v + 0.5), 16, 29)
        if wsOn then wsStart() end
    end
)

makeSection("Settings")

createStepperRow("GUI Scale", 30, 130, 5,
    function() return _G.InvisGuiScale or 100 end,
    function(v)
        _G.InvisGuiScale = v
        GlobalUIScale.Scale = math.clamp(v / 100, 0.3, 1.3)
    end,
    "%"
)

local draggingPanel = false
local dragStart, startPos
AddConn(Header.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        draggingPanel = true; dragStart = i.Position; startPos = Main.Position
    end
end))
AddConn(UserInputService.InputChanged:Connect(function(input)
    if draggingPanel and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end))
AddConn(UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        if draggingPanel then
            draggingPanel = false
            local pos = Main.Position
            _G.InvisGuiPosXScale = pos.X.Scale
            _G.InvisGuiPosXOffset = pos.X.Offset
            _G.InvisGuiPosYScale = pos.Y.Scale
            _G.InvisGuiPosYOffset = pos.Y.Offset
            SaveSettings()
        end
    end
end))

AddConn(UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local keyName = input.KeyCode.Name

    if _G.WaitingForInvisKey then
        _G.WaitingForInvisKey = false
        if keyName and keyName ~= "Unknown" then
            _G.INVISIBLE_STEAL_KEY = keyName
            SaveSettings()
        end
        if _G.InvisKeyButton then _G.InvisKeyButton.Text = _G.INVISIBLE_STEAL_KEY:upper() end
        return
    end

    local invisKeyCode = Enum.KeyCode[_G.INVISIBLE_STEAL_KEY]
    if invisKeyCode and input.KeyCode == invisKeyCode then
        pcall(_G.toggleInvisibleSteal)
        return
    end
end))

do
    local g = getgenv()
    g.EnzoInvisPanelToggle = function()
        for _, c in ipairs(PanelConnections) do pcall(function() if c then c:Disconnect() end end) end
        PanelConnections = {}
        if SMKTInvisActive and _G.SMKTInvisStop then pcall(_G.SMKTInvisStop) end
        wsStop()
        _G.WaitingForInvisKey = false
        local gui = PlayerGui:FindFirstChild("InvisStealPanel")
        if gui then pcall(function() gui:Destroy() end) end
    end
end
AddConn(CloseBtn.MouseButton1Click:Connect(function()
    pcall(getgenv().EnzoInvisPanelToggle)
end))

if _G.SMKTWalkSpeedOn then
    task.spawn(function()
        task.wait(0.5)
        _G.SMKTSetWalkSpeed(true)
    end)
end
