local function createSliderRow(labelText, minVal, maxVal, step, getVal, setVal, suffix)
	local row = makeRow(30)
	makeLabel(row, labelText, 6, UDim2.new(0.4, -6, 0, 12))

	local box = Instance.new("TextBox", row)
	box.AnchorPoint = Vector2.new(1, 0)
	box.Position = UDim2.new(1, -6, 0, 2)
	box.Size = UDim2.new(0, 44, 0, 14)
	box.BackgroundColor3 = THEME_BG
	box.BorderSizePixel = 0
	box.Font = THEME_FONT
	box.TextSize = 9
	box.TextColor3 = THEME_TEXT_PRIMARY
	box.ClearTextOnFocus = false
	box.Text = ""
	corner(box); stroke(box)

	local bar = Instance.new("Frame", row)
	bar.Position = UDim2.new(0, 6, 1, -8)
	bar.Size = UDim2.new(1, -12, 0, 3)
	bar.BackgroundColor3 = THEME_BG
	bar.BorderSizePixel = 0
	corner(bar, 1)
	local fill = Instance.new("Frame", bar)
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = THEME_ACCENT
	fill.BorderSizePixel = 0
	corner(fill, 1)
	local knob = Instance.new("Frame", bar)
	knob.Size = UDim2.new(0, 5, 0, 9)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new(0, 0, 0.5, 0)
	knob.BackgroundColor3 = THEME_TEXT_PRIMARY
	knob.BorderSizePixel = 0
	corner(knob, 1)

	local dragging = false
	local function roundV(v)
		v = math.floor(v / step + 0.5) * step
		if step >= 1 then v = math.floor(v) end
		return math.clamp(v, minVal, maxVal)
	end
	local function visuals(v)
		local alpha = math.clamp((v - minVal) / (maxVal - minVal), 0, 1)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		box.Text = tostring(v) .. (suffix or "")
	end
	local function apply(v)
		v = roundV(v)
		setVal(v)
		visuals(v)
	end
	local function fromX(px)
		local len = math.max(bar.AbsoluteSize.X, 1)
		local rel = math.clamp((px - bar.AbsolutePosition.X) / len, 0, 1)
		apply(minVal + (maxVal - minVal) * rel)
	end
	local function beginDrag(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			isInteractingWithSlider = true
			fromX(i.Position.X)
		end
	end
	AddConn(bar.InputBegan:Connect(beginDrag))
	AddConn(knob.InputBegan:Connect(beginDrag))
	AddConn(UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fromX(i.Position.X)
		end
	end))
	AddConn(UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			if dragging then dragging = false; isInteractingWithSlider = false end
		end
	end))
	AddConn(box.FocusLost:Connect(function()
		local num = tonumber((box.Text:gsub("[^%d%.%-]", "")))
		if num then apply(num) else visuals(roundV(getVal())) end
	end))
	task.defer(function() visuals(roundV(getVal())) end)
	return visuals
end

