local function SMKTStartAntiDie()
	local antiDieHardened = nil
	local antiDieConn, antiDieDiedConn, antiDieHbConn = nil, nil, nil

	local function antiDieHardenRaw(hum)
		if hum.BreakJointsOnDeath then hum.BreakJointsOnDeath = false end
		if hum.RequiresNeck then hum.RequiresNeck = false end
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
	end
	local function antiDieHarden(hum)
		if antiDieHardened == hum then return end
		antiDieHardenRaw(hum)
		antiDieHardened = hum
	end
	local function antiDieRevive(hum)
		pcall(function() hum.Health = hum.MaxHealth end)
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
	end
	local function antiDieBind()
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		antiDieHarden(hum)
		if antiDieConn then pcall(function() antiDieConn:Disconnect() end) end
		if antiDieDiedConn then pcall(function() antiDieDiedConn:Disconnect() end) end
		if antiDieHbConn then pcall(function() antiDieHbConn:Disconnect() end) end
		antiDieConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
			if _G.AntiDieDisabled then return end
			if hum.Health <= 0 then antiDieRevive(hum) end
		end)
		antiDieDiedConn = hum.Died:Connect(function()
			if _G.AntiDieDisabled then return end
			antiDieRevive(hum)
		end)
		local lastHarden = 0
		local adAlive = true
		antiDieHbConn = { Disconnect = function() adAlive = false end }
		local adTick = function()
			if _G.AntiDieDisabled or not hum or not hum.Parent then return end
			local now = os.clock()
			if now - lastHarden >= 0.5 then lastHarden = now; antiDieHarden(hum) end
			if hum.Health <= 0 then antiDieRevive(hum) end
			if _G.SMKTTPHealLock and hum.Health < hum.MaxHealth then
				hum.Health = hum.MaxHealth
			end
			local state = hum:GetState()
			if state == Enum.HumanoidStateType.Dead or state == Enum.HumanoidStateType.Ragdoll
				or state == Enum.HumanoidStateType.FallingDown then
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end
		end
		task.spawn(function()
			while adAlive do
				task.wait(tonumber(_G.SMKTAntiDieHz) or 0.1)
				adTick()
			end
		end)
	end
	antiDieBind()
	LocalPlayer.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then antiDieHarden(hum) end
		task.wait(0.1)
		antiDieBind()
	end)
end

SMKTStartAntiDie()

_G.SMKTWalkSpeed = _G.SMKTWalkSpeed or 16
_G.SMKTWalkSpeedOn = _G.SMKTWalkSpeedOn or false

local wsOn = _G.SMKTWalkSpeedOn or false
local wsConn = nil
local wsDefaultRestored = false

local function wsWantSpeed()
	return math.clamp(tonumber(_G.SMKTWalkSpeed) or 16, 16, 29)
end

local function wsRestoreDefault()
	pcall(function()
		local c = LocalPlayer.Character
		local hum = c and c:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 16 end
	end)
	wsDefaultRestored = true
end

local function wsStop()
	if wsConn then
		pcall(function() wsConn:Disconnect() end)
		wsConn = nil
	end
	if not wsDefaultRestored then wsRestoreDefault() end
end

local function wsStart()
	wsStop()
	wsDefaultRestored = false
	wsConn = RunService.Heartbeat:Connect(function(dt)
		if _G.SMKT_DISABLE_VELOCITY then return end
		local c = LocalPlayer.Character
		if not c then return end
		local hum = c:FindFirstChildOfClass("Humanoid")
		local hrp = c:FindFirstChild("HumanoidRootPart")
		if not hum or not hrp or hum.Health <= 0 then return end
		local want = wsWantSpeed()
		local md = hum.MoveDirection
		if md.Magnitude > 0 and want > hum.WalkSpeed then
			hrp.CFrame = hrp.CFrame + (md * (want - hum.WalkSpeed) * dt)
		end
	end)
end

_G.SMKTSetWalkSpeed = function(on)
	wsOn = on and true or false
	_G.SMKTWalkSpeedOn = wsOn
	if wsOn then
		wsStart()
	else
		wsStop()
	end
	if type(_G.SMKTPaintWalkSpeed) == "function" then pcall(_G.SMKTPaintWalkSpeed) end
end

_G.toggleWalkSpeed = function()
	_G.SMKTSetWalkSpeed(not wsOn)
end

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.4)
	if wsOn then wsStart() end
end)

if _G.SMKTWalkSpeedOn == true then
	task.defer(function() _G.SMKTSetWalkSpeed(true) end)
end

